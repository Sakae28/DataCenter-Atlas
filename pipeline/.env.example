# Copy to pipeline/.env (or set in CI secrets). All variables are optional —
# with none set, the pipeline falls back to a keyword heuristic.

# LLM backend selection: api | kimi-cli | auto (default auto).
#   api      OpenAI-compatible chat completions API (requires LLM_API_KEY).
#   kimi-cli use the locally installed, already-logged-in `kimi` CLI
#            (kimi -p <prompt>) — no API key needed, uses your subscription.
#   auto     api if LLM_API_KEY is set, else kimi-cli if `kimi` is on PATH,
#            else heuristic mode.
LLM_BACKEND=auto

# Required only for the api backend. Any OpenAI-compatible API key.
LLM_API_KEY=sk-...

# Optional, api backend only. Base URL of an OpenAI-compatible endpoint.
LLM_BASE_URL=https://api.openai.com/v1

# Optional, api backend only. Model used for all LLM steps.
LLM_MODEL=gpt-4o-mini

# --- Fetching ---
# Optional. Explicit proxy for fetching sources, e.g. a local accelerator.
# FETCH_PROXY=http://127.0.0.1:7078

# Optional, local use only. Set to 1 when your proxy MITMs HTTPS with its
# own CA (TLS verification is then skipped). Never enable in CI.
# FETCH_INSECURE_TLS=0
