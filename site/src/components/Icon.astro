---
/**
 * Tiny inline-SVG icon set. Hand-written stroke icons (24×24 grid,
 * currentColor, round caps/joins) — no icon library dependency.
 * Usage: <Icon name="flame" size={13} />
 */

const ICONS = {
  // Sidebar / navigation
  bolt: '<path d="M13 2 3 14h9l-1 8 10-12h-9l1-8z"/>',
  // Reports nav: newspaper/document
  newspaper:
    '<path d="M4 5.5h13v13a2 2 0 0 0 2 2H6a2 2 0 0 1-2-2v-13z"/><path d="M17 8.5h2.5a1 1 0 0 1 1 1V18a2 2 0 0 1-2 2"/><path d="M7.5 9.5h6"/><path d="M7.5 13h6"/><path d="M7.5 16.5h4"/>',
  info: '<circle cx="12" cy="12" r="9.2"/><path d="M12 11.2v5"/><path d="M12 7.8h.01"/>',
  server:
    '<rect x="3" y="4" width="18" height="7" rx="2"/><rect x="3" y="13" width="18" height="7" rx="2"/><path d="M7 7.5h.01"/><path d="M7 16.5h.01"/>',
  // Trending heat
  flame:
    '<path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.07-2.14-.22-4.05 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.15.43-2.29 1-3a2.5 2.5 0 0 0 2.5 2.5z"/>',
  // Filter bar
  search: '<circle cx="11" cy="11" r="7"/><path d="m20.2 20.2-3.6-3.6"/>',
  funnel: '<path d="M4 4.5h16l-6.2 7.2v6l-3.6 1.8v-7.8L4 4.5z"/>',
  layers:
    '<path d="M12 2.5 2.5 7.5 12 12.5l9.5-5L12 2.5z"/><path d="m2.5 12.5 9.5 5 9.5-5"/><path d="m2.5 17.5 9.5 5 9.5-5"/>',
  // Day-group disclosure
  chevron: '<path d="m9 5.5 6.5 6.5L9 18.5"/>',
  // Detail page action bar
  'arrow-left': '<path d="M19 12H5"/><path d="m11 18-6-6 6-6"/>',
  // Project profile key dates
  calendar:
    '<rect x="3" y="4.5" width="18" height="17" rx="2"/><path d="M8 2.5v4"/><path d="M16 2.5v4"/><path d="M3 9.5h18"/>',
  external:
    '<path d="M15 3.5h5.5V9"/><path d="M20 4.5 10.5 14"/><path d="M18.5 13.5V18a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4.5"/>',
  // Pipeline view toggle
  list: '<path d="M8.5 6h12"/><path d="M8.5 12h12"/><path d="M8.5 18h12"/><path d="M4 6h.01"/><path d="M4 12h.01"/><path d="M4 18h.01"/>',
  map: '<path d="M9 3.5 3 5.8v14.7l6-2.3 6 2.3 6-2.3V3.5l-6 2.3-6-2.3z"/><path d="M9 3.5v14.7"/><path d="M15 5.8v14.7"/>',
  // Favorites
  bookmark: '<path d="M6.5 3.5h11a1 1 0 0 1 1 1v16l-6.5-4.2L5.5 20.5v-16a1 1 0 0 1 1-1z"/>',
  // Footer RSS link
  rss: '<circle cx="5.5" cy="18.5" r="1.6"/><path d="M4.5 11a8.5 8.5 0 0 1 8.5 8.5"/><path d="M4.5 4.5a15 15 0 0 1 15 15"/>',
  // Company stats
  check: '<path d="m4.5 12.5 5 5 10-11"/>',
  globe:
    '<circle cx="12" cy="12" r="9"/><path d="M3 12h18"/><path d="M12 3c2.6 2.6 4 5.7 4 9s-1.4 6.4-4 9c-2.6-2.6-4-5.7-4-9s1.4-6.4 4-9z"/>',
  'map-pin':
    '<path d="M12 21.5s7.5-5.6 7.5-11.5a7.5 7.5 0 1 0-15 0C4.5 15.9 12 21.5 12 21.5z"/><circle cx="12" cy="10" r="2.6"/>',
  // Companies nav
  building: '<rect x="4" y="3" width="16" height="18" rx="1.5"/><path d="M8 7.5h2.5"/><path d="M13.5 7.5H16"/><path d="M8 11.5h2.5"/><path d="M13.5 11.5H16"/><path d="M8 15.5h2.5"/><path d="M13.5 15.5H16"/><path d="M10 21v-3h4v3"/>',
} as const;

interface Props {
  name: keyof typeof ICONS;
  /** Rendered width/height in px (icon scales from a 24×24 grid). */
  size?: number;
  strokeWidth?: number;
  class?: string;
}

const { name, size = 16, strokeWidth = 1.8, class: className } = Astro.props;
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={ICONS[name]}
/>
