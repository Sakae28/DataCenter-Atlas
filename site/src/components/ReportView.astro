---
/**
 * Shared renderer for one report issue (weekly or monthly): left rail with
 * Weekly/Monthly tabs + month-grouped issue list, main column with masthead,
 * lede card, stat strip, key-themes index, per-theme sections and project
 * milestones. Used by reports/index.astro (latest issue) and the
 * reports/weekly|monthly/[id] routes, in both languages (lang prop).
 */
import Icon from './Icon.astro';
import {
  groupByMonth,
  issueBadge,
  formatRange,
  reportPath,
  type Report,
} from '../lib/reports';
import { formatDate, sourceDisplayName, type NewsStory } from '../lib/news';
import { STATUS_META, type ProjectStatus } from '../lib/projects';
import { lf, langPrefix, STATUS_LABELS_ZH, type Lang } from '../lib/i18n';

const statusMeta = (s?: string | null) =>
  s && s in STATUS_META ? STATUS_META[s as ProjectStatus] : null;

interface Props {
  report: Report;
  reports: Report[];
  storiesById: Map<string, NewsStory>;
  lang?: Lang;
}

const { report, reports, storiesById, lang = 'en' } = Astro.props;
const zh = lang === 'zh';
const base = import.meta.env.BASE_URL;
const prefix = langPrefix(lang);
const href = (r: Report) => `${base}${prefix}${reportPath(r)}`;

const sameType = reports.filter((r) => r.type === report.type);
const railGroups = groupByMonth(sameType, lang);
const latestOf = (type: Report['type']) => reports.find((r) => r.type === type);
const latestWeekly = latestOf('weekly');
const latestMonthly = latestOf('monthly');

const kindLabel = zh
  ? (report.type === 'weekly' ? '周报' : '月报')
  : (report.type === 'weekly' ? 'WEEKLY' : 'MONTHLY');
const briefLabel = zh
  ? (report.type === 'weekly' ? '本周速览' : '本月速览')
  : (report.type === 'weekly' ? 'The week in brief' : 'The month in brief');
const totalThemeStories = report.themes.reduce((n, t) => n + t.story_ids.length, 0);

const fmtDay = (iso: string) => formatDate(iso.slice(0, 10), lang);
const reportTitle = lf(report, 'title', lang);
const storyWord = (n: number) => (zh ? `${n} 条新闻` : `${n} ${n === 1 ? 'story' : 'stories'}`);
const statusLabel = (s: string | null | undefined, fallback: string) =>
  zh && s ? (STATUS_LABELS_ZH[s] ?? fallback) : fallback;
---

<div class="report-layout">
  <aside class="report-rail" aria-label={zh ? '报告列表' : 'Report issues'}>
    <div class="report-tabs" role="tablist">
      {latestWeekly ? (
        <a
          class="report-tab"
          class:list={[{ 'is-active': report.type === 'weekly' }]}
          href={href(latestWeekly)}
          role="tab"
          aria-selected={report.type === 'weekly'}
        >{zh ? '周报' : 'Weekly'}</a>
      ) : (
        <span class="report-tab is-disabled">{zh ? '周报' : 'Weekly'}</span>
      )}
      {latestMonthly ? (
        <a
          class="report-tab"
          class:list={[{ 'is-active': report.type === 'monthly' }]}
          href={href(latestMonthly)}
          role="tab"
          aria-selected={report.type === 'monthly'}
        >{zh ? '月报' : 'Monthly'}</a>
      ) : (
        <span class="report-tab is-disabled">{zh ? '月报' : 'Monthly'}</span>
      )}
    </div>

    {railGroups.map((group, gi) => (
      <details class="report-group" open={gi === 0}>
        <summary class="report-group-head">
          <Icon name="chevron" size={12} class="report-group-chev" />
          {group.label}
          <span class="report-group-count">{group.reports.length}</span>
        </summary>
        <ul class="report-issue-list">
          {group.reports.map((r) => (
            <li>
              <a
                class="report-issue"
                class:list={[{ 'is-active': r.type === report.type && r.period === report.period }]}
                href={href(r)}
              >
                <span class="report-issue-badge">{issueBadge(r)}</span>
                <span class="report-issue-title">{lf(r, 'title', lang)}</span>
                {!r.complete && <span class="report-issue-partial" title={zh ? '不完整：周期仍在进行中或部分日期缺失' : 'Partial: period still in progress or days missing'}>•</span>}
              </a>
            </li>
          ))}
        </ul>
      </details>
    ))}
  </aside>

  <div class="report-main">
    <header class="report-masthead">
      <p class="report-kicker">
        {zh
          ? `VOL. ${report.period} · ${report.stats.stories} 条新闻 · DATACENTER ATLAS ${kindLabel}`
          : `VOL. ${report.period} · ${report.stats.stories} STORIES · DATACENTER ATLAS ${kindLabel}`}
      </p>
      <h1 class="report-title">{reportTitle}</h1>
      <p class="report-meta">
        {formatRange(report, lang)} · {kindLabel} · {zh ? '自动汇编' : 'Compiled automatically'}
        {!report.complete && (
          <span class="badge featured report-partial-badge">{zh ? '不完整 — 周期进行中或归档有缺失' : 'Partial — period in progress or archive gaps'}</span>
        )}
      </p>
    </header>

    <section class="panel report-lede">
      <p class="report-section-label">{briefLabel}</p>
      <p class="report-lede-text">{lf(report, 'lede', lang)}</p>
    </section>

    <section class="report-stat-grid">
      <div class="panel report-stat">
        <p class="report-stat-value">{report.stats.stories}</p>
        <p class="report-stat-label">{zh ? '新闻' : 'Stories'}</p>
      </div>
      <div class="panel report-stat">
        <p class="report-stat-value">{report.stats.sources}</p>
        <p class="report-stat-label">{zh ? '来源' : 'Sources'}</p>
      </div>
      <div class="panel report-stat">
        <p class="report-stat-value">{report.stats.days}</p>
        <p class="report-stat-label">{zh ? '覆盖天数' : 'Days covered'}</p>
      </div>
      <div class="panel report-stat">
        <p class="report-stat-value">{zh ? `约 ${report.stats.read_minutes} 分钟` : `≈${report.stats.read_minutes} min`}</p>
        <p class="report-stat-label">{zh ? '读完本页' : 'To read this page'}</p>
      </div>
    </section>

    {report.themes.length > 0 && (
      <section class="panel report-themes-index">
        <div class="report-themes-head">
          <h2 class="panel-title">{zh ? '关键主题' : 'Key themes'}</h2>
          <span class="report-themes-count">{zh ? `${report.themes.length} 个主题 · ${totalThemeStories} 条新闻` : `${report.themes.length} themes · ${totalThemeStories} stories`}</span>
        </div>
        <ol class="report-theme-list">
          {report.themes.map((theme, i) => (
            <li>
              <a class="report-theme-row" href={`#theme-${i + 1}`}>
                <span class="report-theme-num">{String(i + 1).padStart(2, '0')}</span>
                <span class="report-theme-heading">{lf(theme, 'heading', lang)}</span>
                <span class="report-theme-count">{theme.story_ids.length}</span>
              </a>
            </li>
          ))}
        </ol>
      </section>
    )}

    {report.themes.map((theme, i) => (
      <section class="report-theme-section" id={`theme-${i + 1}`}>
        <h2 class="report-theme-title">
          <span class="report-theme-num">{String(i + 1).padStart(2, '0')}</span>
          {lf(theme, 'heading', lang)}
          <span class="report-theme-count">{storyWord(theme.story_ids.length)}</span>
        </h2>
        {lf(theme, 'narrative', lang) && <p class="report-theme-narrative">{lf(theme, 'narrative', lang)}</p>}
        <div class="panel report-story-list">
          {theme.story_ids.map((id) => {
            const story = storiesById.get(id);
            if (!story) return null;
            return (
              <div class="report-story-row">
                <a class="report-story-title" href={`${base}${prefix}/news/${story.id}/`}>{lf(story, 'title', lang)}</a>
                <span class="report-story-meta">
                  <span class="report-story-source">{sourceDisplayName(story.sources[0], story)}</span>
                  <span class="report-story-date">{fmtDay(story.published_at)}</span>
                </span>
              </div>
            );
          })}
        </div>
      </section>
    ))}

    {report.project_milestones.length > 0 && (
      <section class="report-theme-section">
        <h2 class="report-theme-title">
          {zh ? '项目里程碑' : 'Project milestones'}
          <span class="report-theme-count">{report.project_milestones.length}</span>
        </h2>
        <div class="panel report-story-list">
          {report.project_milestones.map((m) => (
            <div class="report-story-row">
              <span class="report-story-title">
                <a href={`${base}${prefix}/projects/${m.project_id}/`}>{m.name}</a>
                <span class="report-milestone-op">{m.operator}</span>
              </span>
              <span class="report-story-meta">
                <span class="report-milestone-change">
                  {(() => {
                    const cur = statusMeta(m.status);
                    const prev = statusMeta(m.prev_status);
                    if (!cur) return m.change;
                    if (m.kind === 'status_change' && prev) {
                      return (
                        <>
                          <span class={`badge ${prev.className}`}>{statusLabel(m.prev_status, prev.label)}</span>
                          {' → '}
                          <span class={`badge ${cur.className}`}>{statusLabel(m.status, cur.label)}</span>
                        </>
                      );
                    }
                    return <span class={`badge ${cur.className}`}>{statusLabel(m.status, cur.label)}</span>;
                  })()}
                </span>
                <span class="report-story-date">{fmtDay(m.date)}</span>
              </span>
            </div>
          ))}
        </div>
      </section>
    )}

    <p class="report-footnote">
      {zh
        ? `由每日新闻归档于 ${formatDate(report.generated_at.slice(0, 10), lang)} 自动汇编。主题与叙述由 AI 整理；所有链接新闻均已注明原始来源。`
        : `Generated ${formatDate(report.generated_at.slice(0, 10))} from the daily digest archive. Themes and narratives are AI-compiled; all linked stories credit their original sources.`}
    </p>
  </div>
</div>
