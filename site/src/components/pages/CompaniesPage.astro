---
/**
 * Company directory — shared by pages/companies/index.astro (en) and
 * pages/zh/companies/index.astro (zh). Category names map through
 * CATEGORY_LABELS_ZH; blurbs prefer the curated blurb_zh when present.
 */
import FollowButton from '../FollowButton.astro';
import { loadCompanies, logoUrl, CATEGORY_ORDER, type Company } from '../../lib/companies';
import { langPrefix, CATEGORY_LABELS_ZH, type Lang } from '../../lib/i18n';

interface Props {
  lang?: Lang;
}
const { lang = 'en' } = Astro.props;
const zh = lang === 'zh';

const companies = loadCompanies();
const base = import.meta.env.BASE_URL;
const prefix = langPrefix(lang);

const byCategory = new Map<string, Company[]>();
for (const c of companies) {
  const list = byCategory.get(c.category) ?? [];
  list.push(c);
  byCategory.set(c.category, list);
}
const categories = CATEGORY_ORDER.filter((cat) => byCategory.has(cat));

const categoryLabel = (cat: string) =>
  zh ? (CATEGORY_LABELS_ZH[cat] ?? cat) : cat;

const blurbOf = (c: Company) =>
  (zh ? (c.blurb_zh ?? c.blurb) : c.blurb) ??
  (zh
    ? `数据中心运营商，共追踪 ${c.stats.facilities} 个设施。`
    : `Data center operator with ${c.stats.facilities} tracked facilities.`);
---

<header class="page-head">
  <div>
    <h1 class="page-title">{zh ? '公司' : 'Companies'}</h1>
    <p class="page-sub">{zh ? '亚太数据中心管线背后的运营商' : "The operators behind APAC's data center pipeline"}</p>
  </div>
</header>

{categories.map((cat) => (
  <section class="co-section">
    <h2 class="co-cat">{categoryLabel(cat)}</h2>
    <div class="co-grid">
      {(byCategory.get(cat) ?? []).map((c) => {
        const logo = c.domain ? logoUrl(c.domain) : null;
        return (
        <a class="co-card" href={`${base}${prefix}/companies/${c.slug}/`} data-company-slug={c.slug}>
          <span class="co-logo">
            {logo && (
              <img
                src={logo}
                alt=""
                loading="lazy"
                onerror="this.remove()"
              />
            )}
            <span class="co-letter" aria-hidden="true">{c.name.charAt(0)}</span>
          </span>
          <span class="co-body">
            <span class="co-name">
              {c.name}
              <span class="co-new-dot" title={zh ? '自你上次访问后有新动态' : 'New activity since your last visit'} hidden></span>
            </span>
            <span class="co-blurb">
              {blurbOf(c)}
            </span>
          </span>
          <span class="co-card-side">
            <FollowButton slug={c.slug} variant="card" lang={lang} />
            <span class="co-cta">{zh ? '查看详情 →' : 'View details →'}</span>
          </span>
        </a>
        );
      })}
    </div>
  </section>
))}
