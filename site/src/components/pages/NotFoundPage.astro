---
/**
 * 404 body — shared by pages/404.astro (en) and pages/zh/404.astro (zh).
 * GitHub Pages serves the root 404.html for any unknown path.
 */
import Icon from '../Icon.astro';
import { langPrefix, type Lang } from '../../lib/i18n';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const zh = lang === 'zh';
const base = import.meta.env.BASE_URL;
const prefix = langPrefix(lang);
---

<div class="empty-state not-found">
  <span class="empty-icon"><Icon name="map" size={26} /></span>
  <p class="empty-title">{zh ? '这个页面漂出了地图' : 'This page drifted off the map'}</p>
  <p class="empty-sub">{zh ? '你要找的页面不存在，或已被移动。' : "The page you're looking for doesn't exist or may have been moved."}</p>
  <div class="empty-actions">
    <a class="btn btn-primary" href={`${base}${prefix}/`}>{zh ? '首页' : 'Home'}</a>
    <a class="btn" href={`${base}${prefix}/pipeline/`}>{zh ? '项目管线' : 'Pipeline'}</a>
    <a class="btn" href={`${base}${prefix}/companies/`}>{zh ? '公司' : 'Companies'}</a>
  </div>
</div>
