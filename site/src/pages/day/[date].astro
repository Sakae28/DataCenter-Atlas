---
/**
 * Per-day digest archive: /day/2026-08-26/. Older days are not embedded in
 * the homepage (it ships only the latest week) — each gets this static page.
 */
import Base from '../../layouts/Base.astro';
import DayPage from '../../components/pages/DayPage.astro';
import { loadNewsDays, formatDate, type NewsDay } from '../../lib/news';

export function getStaticPaths() {
  const { days } = loadNewsDays();
  return days
    .filter((d) => d.stories.length > 0)
    .map((day) => ({ params: { date: day.date }, props: { day } }));
}

interface Props {
  day: NewsDay;
}

const { day } = Astro.props;
---

<Base title={`Digest ${day.date}`} description={`APAC data center news digest for ${formatDate(day.date)}`} active="latest" lang="en">
  <DayPage day={day} lang="en" />
</Base>
