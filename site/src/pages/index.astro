---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import FavButton from '../components/FavButton.astro';
import {
  loadNewsDays,
  formatDate,
  formatTime,
  weekdayOf,
  sourceDisplayName,
  hasDistinctSummary,
  REGIONS,
  REGION_LABELS,
} from '../lib/news';
import { loadProjects, buildStoryProjectIndex } from '../lib/projects';
import { companySlugMap } from '../lib/companies';

const { days, source } = loadNewsDays();
const base = import.meta.env.BASE_URL;
// Reverse index story_id → project, for the "Project: <name>" link on cards.
const projectByStory = buildStoryProjectIndex(loadProjects().projects);
// Canonical company/operator name (lowercased) → directory slug, for
// linking the company chips on story cards to company pages when one exists.
const companySlugByName = companySlugMap();
const latest = days[0];
const hotStories = latest
  ? latest.hot
      .map((id) => latest.stories.find((s) => s.id === id))
      .filter((s) => s !== undefined)
  : [];

// "Sources today" list, computed from the latest digest.
const sourceCounts = new Map<string, number>();
for (const story of latest?.stories ?? []) {
  for (const s of story.sources) {
    sourceCounts.set(s.name, (sourceCounts.get(s.name) ?? 0) + 1);
  }
}
const railSources = [...sourceCounts.entries()].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));

/** Lowercase haystack for the client-side search filter. */
const searchText = (title: string, summary: string, companies?: string[]) =>
  `${title} ${summary} ${(companies ?? []).join(' ')}`.toLowerCase();
---

<Base title="Latest" active="latest">
  <header class="page-head">
    <div>
      <h1 class="page-title">Latest</h1>
      {latest && (
        <p class="page-sub">
          {weekdayOf(latest.date)}, {formatDate(latest.date)} · AI-curated APAC data center digest
        </p>
        <p class="tz-note">Times shown in your local timezone</p>
      )}
    </div>
  </header>

  <div class="filter-bar">
    <div class="tabs" role="group" aria-label="Filter by region">
      <button class="tab is-active" data-region="all">All</button>
      {REGIONS.map((r) => (
        <button class="tab" data-region={r}>{REGION_LABELS[r]}</button>
      ))}
    </div>
    <div class="filter-right">
      <button class="tab saved-toggle" type="button" aria-pressed="false">
        <Icon name="bookmark" size={13} /> Saved
      </button>
      {railSources.length > 0 && (
        <details class="sources-menu">
          <summary>
            <Icon name="layers" size={14} class="summary-icon" />
            Sources today
            <span class="sources-count">{railSources.length}</span>
          </summary>
          <ul class="sources-pop">
            {railSources.map(([name, count]) => (
              <li><span class="rail-source-name">{name}</span><span class="rail-source-count">{count}</span></li>
            ))}
          </ul>
        </details>
      )}
      <div class="search-wrap">
        <Icon name="search" size={14} class="search-icon" />
        <input
          class="search"
          type="search"
          placeholder="Search title, summary…"
          aria-label="Search stories by title or summary"
        />
      </div>
    </div>
  </div>

  {source === 'fixtures' && (
    <p class="dev-notice">Showing bundled fixture data — the pipeline has not produced output yet.</p>
  )}

  {hotStories.length > 0 && (
    <section class="trending">
      <h2 class="panel-title">Trending</h2>
      <ol class="hot-list">
        {hotStories.map((story, i) => (
          <li class="hot-item" data-id={story.id} data-regions={story.regions.join(' ')} data-search={searchText(story.title, story.summary, story.companies)}>
            <span class="hot-rank" class:list={[{ 'is-top': i < 3 }]}>{i + 1}</span>
            <a class="hot-title" href={`${base}/news/${story.id}/`}>{story.title}</a>
            {story.companies && story.companies.length > 0 && (
              <span class="hot-companies">{story.companies.join(' · ')}</span>
            )}
            <span class="hot-right">
              <span class="hot-heat"><Icon name="flame" size={13} />{story.heat} {story.heat === 1 ? 'source' : 'sources'}</span>
              {story.score !== null && <span class="hot-score">{story.score}/100</span>}
              <FavButton type="news" id={story.id} size={13} />
            </span>
          </li>
        ))}
      </ol>
    </section>
  )}

  <section class="timeline">
    {days.length === 0 && <p>No news available yet.</p>}
    {days.map((day, i) => (
      <details class="day-group" open={i === 0}>
        <summary class="day-heading">
          <h2 class="day-heading-line">
            <span class="day-date">{formatDate(day.date)}</span>
            <Icon name="chevron" size={14} class="day-chev" />
            <span class="day-sub">{weekdayOf(day.date)} · {day.stories.length} {day.stories.length === 1 ? 'story' : 'stories'}</span>
          </h2>
        </summary>
        <div class="story-list">
          {day.stories.map((story) => (
            <div class="story-row" data-id={story.id} data-regions={story.regions.join(' ')} data-search={searchText(story.title, story.summary, story.companies)}>
              <div class="story-rail" aria-hidden="true">
                <time class="rail-time js-time" data-time-format="time" data-ts={story.published_at} datetime={story.published_at}>{formatTime(story.published_at)}</time>
                <span class="rail-dot"></span>
              </div>
              <article class="story-card">
                <div class="story-top">
                  <div class="story-origin">
                    <span class="story-source-name">{sourceDisplayName(story.sources[0], story)}</span>
                    {story.featured && <span class="badge featured">Featured</span>}
                  </div>
                  <div class="story-actions">
                    {story.score !== null && (
                      <span class="ai-score" title="AI relevance score">AI score {story.score}/100</span>
                    )}
                    <FavButton type="news" id={story.id} />
                  </div>
                </div>
                <h3 class="story-title">
                  <a class="stretched-link" href={`${base}/news/${story.id}/`}>{story.title}</a>
                </h3>
                {hasDistinctSummary(story.title, story.summary) && (
                  <p class="story-summary">{story.summary}</p>
                )}
                <div class="story-tags">
                  {story.regions.map((r) => (
                    <span class="chip region">{REGION_LABELS[r]}</span>
                  ))}
                  {story.companies?.map((c) => {
                    const slug = companySlugByName.get(c.toLowerCase());
                    return slug ? (
                      <a class="chip company chip-link" href={`${base}/companies/${slug}/`}>{c}</a>
                    ) : (
                      <span class="chip company">{c}</span>
                    );
                  })}
                  {story.topics.map((t) => (
                    <span class="chip topic">#{t}</span>
                  ))}
                </div>
                {(() => {
                  const p = projectByStory.get(story.id);
                  return p ? (
                    <a class="project-link" href={`${base}/projects/${p.id}/`}>
                      <Icon name="server" size={12} />Project: {p.name}
                    </a>
                  ) : null;
                })()}
                {story.sources.length > 1 && (
                  <p class="also-reported">
                    Also reported by{' '}
                    {story.sources.slice(1).map((s, i) => (
                      <>
                        <a href={s.url}>{sourceDisplayName(s, story)}</a>{i < story.sources.length - 2 ? ', ' : ''}
                      </>
                    ))}
                  </p>
                )}
                {story.why_it_matters && (
                  <p class="why-it-matters">
                    <span class="why-label">Why it matters</span>
                    {story.why_it_matters}
                  </p>
                )}
              </article>
            </div>
          ))}
        </div>
      </details>
    ))}
  </section>

  <div class="empty-state" id="empty-state" hidden>
    <span class="empty-icon empty-icon-saved"><Icon name="bookmark" size={26} /></span>
    <span class="empty-icon empty-icon-filter" hidden><Icon name="search" size={26} /></span>
    <p class="empty-title" id="empty-title"></p>
    <p class="empty-sub" id="empty-sub"></p>
  </div>

  <script>
    const pills = document.querySelectorAll<HTMLButtonElement>('.tabs .tab');
    const cards = document.querySelectorAll<HTMLElement>('[data-regions]');
    const dayGroups = [...document.querySelectorAll<HTMLDetailsElement>('details.day-group')];
    const trending = document.querySelector<HTMLElement>('.trending');
    const searchInput = document.querySelector<HTMLInputElement>('.search');

    let activeRegion = 'all';
    let query = '';
    let savedOnly = false;
    const savedToggle = document.querySelector<HTMLButtonElement>('.saved-toggle');

    function favNewsIds(): Set<string> {
      try {
        const raw = JSON.parse(localStorage.getItem('dc-favs') ?? '{}');
        return new Set(Array.isArray(raw.news) ? raw.news : []);
      } catch {
        return new Set();
      }
    }

    function applyFilters() {
      const favs = savedOnly ? favNewsIds() : null;
      cards.forEach((el) => {
        const regionOk =
          activeRegion === 'all' || (el.dataset.regions ?? '').split(' ').includes(activeRegion);
        const queryOk = query === '' || (el.dataset.search ?? '').includes(query);
        const favOk = !favs || favs.has(el.dataset.id ?? '');
        el.classList.toggle('is-hidden', !(regionOk && queryOk && favOk));
      });
      // Hide day groups / trending panel when nothing inside is visible.
      // While a filter is active, auto-open collapsed days that have matches;
      // when cleared, restore the default state (latest day open, rest closed).
      const filtering = activeRegion !== 'all' || query !== '' || savedOnly;
      dayGroups.forEach((group, i) => {
        const visible = group.querySelectorAll('.story-row:not(.is-hidden)').length;
        group.classList.toggle('is-hidden', visible === 0);
        group.open = filtering ? visible > 0 : i === 0;
      });
      if (trending) {
        const visible = trending.querySelectorAll('.hot-item:not(.is-hidden)').length;
        trending.classList.toggle('is-hidden', visible === 0);
      }
      // Empty state: friendly placeholder instead of a blank page when a
      // filter (especially Saved with no bookmarks yet) hides everything.
      const emptyEl = document.getElementById('empty-state');
      if (emptyEl) {
        const visibleRows = document.querySelectorAll('.story-row:not(.is-hidden)').length;
        const visibleHot = trending ? trending.querySelectorAll('.hot-item:not(.is-hidden)').length : 0;
        const isEmpty = filtering && visibleRows === 0 && visibleHot === 0;
        emptyEl.hidden = !isEmpty;
        if (isEmpty) {
          const title = emptyEl.querySelector('#empty-title');
          const sub = emptyEl.querySelector('#empty-sub');
          const iconSaved = emptyEl.querySelector('.empty-icon-saved');
          const iconFilter = emptyEl.querySelector('.empty-icon-filter');
          if (savedOnly) {
            if (title) title.textContent = 'No saved stories yet';
            if (sub) sub.textContent = 'Tap the bookmark icon on any story to keep it here.';
          } else {
            if (title) title.textContent = 'No stories match';
            if (sub) sub.textContent = 'Try a different region or search term.';
          }
          iconSaved?.toggleAttribute('hidden', !savedOnly);
          iconFilter?.toggleAttribute('hidden', savedOnly);
        }
      }
    }

    savedToggle?.addEventListener('click', () => {
      savedOnly = !savedOnly;
      savedToggle.classList.toggle('is-active', savedOnly);
      savedToggle.setAttribute('aria-pressed', String(savedOnly));
      applyFilters();
    });

    document.addEventListener('dcfav:change', () => {
      if (savedOnly) applyFilters();
    });

    pills.forEach((pill) => {
      pill.addEventListener('click', () => {
        pills.forEach((p) => p.classList.remove('is-active'));
        pill.classList.add('is-active');
        activeRegion = pill.dataset.region ?? 'all';
        applyFilters();
      });
    });

    searchInput?.addEventListener('input', () => {
      query = searchInput.value.trim().toLowerCase();
      applyFilters();
    });
  </script>
</Base>
