---
import Base from '../../layouts/Base.astro';
import NewsStoryPage from '../../components/pages/NewsStoryPage.astro';
import { loadAllStories, sourceDisplayName, type NewsStory } from '../../lib/news';

export function getStaticPaths() {
  // loadAllStories covers every story from every loaded day (data or
  // fixture fallback) and dedupes ids, so paths are always unique.
  return loadAllStories().map(({ story, dayDate }) => ({
    params: { id: story.id },
    props: { story, dayDate },
  }));
}

interface Props {
  story: NewsStory;
  dayDate: string;
}

const { story } = Astro.props;
---

<Base title={story.title} description={story.summary} active="latest" ogType="article" lang="en">
  <script
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'NewsArticle',
      headline: story.title,
      description: story.summary,
      datePublished: story.published_at,
      author: story.sources.map((s) => ({
        '@type': 'Organization',
        name: sourceDisplayName(s, story),
        url: s.url,
      })),
      isBasedOn: story.sources[0]?.url,
    })}
  />
  <NewsStoryPage story={story} lang="en" />
</Base>
