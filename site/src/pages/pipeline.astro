---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import FavButton from '../components/FavButton.astro';
import HeatMap, { type CountryHeat, type MapPin } from '../components/HeatMap.astro';
import { REGION_LABELS } from '../lib/news';
import { lookupCity, projectX, projectY } from '../lib/geo';
import {
  loadProjects,
  PROJECT_REGIONS,
  PROJECT_STATUSES,
  STATUS_META,
  formatCapacity,
  type Project,
} from '../lib/projects';

const { projects, source } = loadProjects();
const base = import.meta.env.BASE_URL;

/**
 * Rough USD-millions parse of the free-text investment field, used ONLY as a
 * sort key (the cell shows the original string). Fixed approximate FX rates;
 * the field itself stays verbatim.
 */function parseInvestmentUsdM(text: string | null | undefined): number | null {
  if (!text) return null;
  const m = text.match(/(US\$|AU?\$|NZ\$|S\$|SGD|HK\$|HKD|₱|PHP|¥|CNY|RMB|\$)\s*([\d.]+)\s*([BM])\b/i);
  if (!m) return null;
  const amount = parseFloat(m[2]) * (m[3].toUpperCase() === 'B' ? 1000 : 1);
  const rates: Record<string, number> = {
    'US$': 1, '$': 1, 'A$': 0.66, 'AU$': 0.66, 'NZ$': 0.6, 'S$': 0.74, 'SGD': 0.74,
    'HK$': 0.128, 'HKD': 0.128, '₱': 0.018, 'PHP': 0.018, '¥': 0.14, 'CNY': 0.14, 'RMB': 0.14,
  };
  const rate = rates[m[1].toUpperCase()] ?? 1;
  return Math.round(amount * rate);
}

// Server-render rows newest-updated first; the header sort reorders client-side.
// Projects never updated by tracked news (last_updated null) sink to the bottom.
const sorted = [...projects].sort((a, b) => {
  if (a.last_updated === null) return b.last_updated === null ? 0 : 1;
  if (b.last_updated === null) return -1;
  return a.last_updated < b.last_updated ? 1 : -1;
});

// Precompute per-row display data: geocoded state + map pin, investment key.
// Pins are jittered deterministically (city-level geocoding stacks every
// project of a city on one point) so clusters spread into readable clouds.
function jitter(id: string): [number, number] {
  let h = 0;
  for (const c of id) h = (h * 31 + c.charCodeAt(0)) >>> 0;
  const ang = ((h % 360) * Math.PI) / 180;
  const r = 4 + (h % 13); // 4–16 viewBox units ≈ 0.3–1° at this projection
  return [Math.cos(ang) * r, Math.sin(ang) * r];
}

const rows = sorted.map((p) => {
  const geo = lookupCity(p.country, p.city);
  // Exact facility coordinates from directory imports win; fall back to the
  // geocoded city center + deterministic jitter.
  const exact = p.lat != null && p.lon != null;
  const [jx, jy] = exact ? [0, 0] : jitter(p.id);
  const mx = exact ? projectX(p.lon!) : geo ? +(projectX(geo.lon) + jx).toFixed(1) : null;
  const my = exact ? projectY(p.lat!) : geo ? +(projectY(geo.lat) + jy).toFixed(1) : null;
  return {
    p,
    state: geo?.state ?? null,
    mx: mx === null ? null : +mx.toFixed(1),
    my: my === null ? null : +my.toFixed(1),
    geoExact: exact || (geo?.exact ?? false),
    investUsdM: parseInvestmentUsdM(p.investment),
  };
});

// Leased deployments (leased_from set) share their host's building, so their
// capacity is excluded from rollups to avoid double counting the facility.
const totalMw = projects.reduce(
  (sum, p) => sum + (p.leased_from ? 0 : (p.capacity_mw ?? 0)), 0);

// Per-country rollup for the heat map ranking: tracked MW + project count.
const heatByCountry: Record<string, CountryHeat> = {};
for (const p of projects) {
  if (p.leased_from) continue; // tenant lease, capacity lives on the host
  const h = (heatByCountry[p.country] ??= { mw: 0, count: 0 });
  h.mw += p.capacity_mw ?? 0;
  h.count += 1;
}

// One pin per project for the map, in viewBox coordinates. The pin kind
// follows the source's verbatim stage when we have it (Baxtel's "Prospective
// Expansion" / "Land Bank" get their own icons); otherwise the status.
function pinKind(p: Project): MapPin['status'] {
  // A live site with a "Prospective Expansion" sibling gets the ⊕ pin.
  if (p.expansion_planned && p.status === 'operational') return 'expansion';
  const sd = (p.stage_detail ?? '').toLowerCase();
  if (sd === 'prospective expansion') return 'expansion';
  if (sd === 'land bank') return 'landbank';
  return p.status;
}

const pins: MapPin[] = rows
  .filter((r) => r.mx !== null && r.my !== null)
  .map((r) => ({
    id: r.p.id,
    x: r.mx!,
    y: r.my!,
    status: pinKind(r.p),
    title: `${r.p.name} — ${r.p.operator} · ${r.p.city || r.p.country} (${STATUS_META[r.p.status].label})`,
    // For the map-mode hover popup:
    name: r.p.name,
    operator: r.p.operator,
    loc: [r.p.city, r.p.country].filter(Boolean).join(', '),
    cap: formatCapacity(r.p).value,
    statusLabel: STATUS_META[r.p.status].label,
    url: `${base}/projects/${r.p.id}/`,
  }));

type FilterOption = { value: string; label: string; count: number };

/** Distinct values present in the data, alphabetically, with row counts. */
function alphaOptions(values: string[]): FilterOption[] {
  const counts = new Map<string, number>();
  for (const v of values) counts.set(v, (counts.get(v) ?? 0) + 1);
  return [...counts.entries()]
    .map(([value, count]) => ({ value, label: value, count }))
    .sort((a, b) => a.label.localeCompare(b.label));
}

/** Distinct values present in the data, in canonical order, with row counts. */
function orderedOptions(order: readonly string[], labels: Record<string, string>, values: string[]): FilterOption[] {
  const counts = new Map<string, number>();
  for (const v of values) counts.set(v, (counts.get(v) ?? 0) + 1);
  return order
    .filter((v) => counts.has(v))
    .map((v) => ({ value: v, label: labels[v] ?? v, count: counts.get(v) ?? 0 }));
}

const statusLabels = Object.fromEntries(PROJECT_STATUSES.map((s) => [s, STATUS_META[s].label]));

// Short region chip text for the dense table (full labels live on the map).
const REGION_SHORT: Record<string, string> = { 'southeast-asia': 'SE Asia' };
const regionChip = (r: string) => REGION_SHORT[r] ?? REGION_LABELS[r as keyof typeof REGION_LABELS] ?? r;

// Compact date for the dense table ("Aug 14"); detail pages keep the long form.
const shortDate = (date: string) =>
  new Date(`${date}T12:00:00Z`).toLocaleDateString('en-US', {
    month: 'short',
    day: 'numeric',
    timeZone: 'UTC',
  });

// Filter bar above the table. Operator's ~600 options are NOT rendered into
// HTML (page weight); they ship in the embedded JSON and render lazily.
const operatorOptions = alphaOptions(projects.map((p) => p.operator));
const filters = [
  { key: 'operator', label: 'Operator', lazy: true, options: [] as FilterOption[] },
  { key: 'region', label: 'Region', lazy: false, options: orderedOptions(PROJECT_REGIONS, REGION_LABELS, projects.map((p) => p.region)) },
  { key: 'country', label: 'Country', lazy: false, options: alphaOptions(projects.map((p) => p.country)) },
  { key: 'status', label: 'Status', lazy: false, options: orderedOptions(PROJECT_STATUSES, statusLabels, projects.map((p) => p.status)) },
];

/* ---------- Client-render data -------------------------------------------
   Only the first SERVER_ROWS rows ship as HTML (no-JS baseline + fast first
   paint); every row ships as a slim precomputed JSON record the client
   renders/filters/sorts. All display strings are computed here so the
   client-side template stays dumb. */
const SERVER_ROWS = 200;

interface RowData {
  id: string; name: string; op: string; rg: string; rc: string;
  co: string; st: string | null; ci: string; loc: string;
  stt: string; stl: string; stc: string;
  cap: number | null; capv: string; capn: string | null;
  lease: boolean;
  inv: string | null; invm: number | null;
  upd: string | null; upds: string | null;
  u: string; sea: string; mx: number | null; my: number | null; ex: boolean;
}

const allRows: RowData[] = rows.map(({ p, state, mx, my, geoExact, investUsdM }) => {
  const cap = formatCapacity(p);
  const loc = [...new Set([p.city, state].filter(Boolean))].join(', ');
  return {
    id: p.id,
    name: p.name,
    op: p.operator,
    rg: p.region,
    rc: regionChip(p.region),
    co: p.country,
    st: state,
    ci: p.city,
    loc,
    stt: p.status,
    stl: STATUS_META[p.status].label,
    stc: STATUS_META[p.status].className,
    cap: p.capacity_mw,
    capv: cap.value,
    capn: cap.note ?? null,
    lease: !!p.leased_from,
    inv: p.investment ?? null,
    invm: investUsdM,
    upd: p.last_updated,
    upds: p.last_updated ? shortDate(p.last_updated) : null,
    u: `${base}/projects/${p.id}/`,
    sea: `${p.name} ${p.operator} ${p.city} ${state ?? ''} ${p.country}`.toLowerCase(),
    mx, my, ex: geoExact,
  };
});

const clientData = { rows: allRows, operators: operatorOptions };
const clientJson = JSON.stringify(clientData).replace(/</g, '\\u003c');
const serverRows = rows.slice(0, SERVER_ROWS);
---

<Base title="Pipeline" active="pipeline">
  <header class="page-head">
    <div>
      <h1 class="page-title">Pipeline</h1>
      <p class="page-sub">Data center projects tracked across Asia-Pacific</p>
    </div>
    <div class="view-toggle" role="group" aria-label="Pipeline view">
      <button type="button" class="view-toggle-btn is-active" data-mode="list" aria-pressed="true">
        <Icon name="list" size={13} /> List
      </button>
      <button type="button" class="view-toggle-btn" data-mode="map" aria-pressed="false">
        <Icon name="map" size={13} /> Map
      </button>
    </div>
  </header>

  {source === 'fixtures' && (
    <p class="dev-notice">Showing bundled fixture data — the pipeline has not produced projects.json yet.</p>
  )}

  <p class="pipeline-stats">
    <Icon name="server" size={13} />
    <span id="stat-count">{projects.length} {projects.length === 1 ? 'project' : 'projects'}</span>
    <span class="stats-sep" aria-hidden="true">·</span>
    <span id="stat-mw">{Math.round(totalMw).toLocaleString('en-US')} MW tracked</span>
    <span class="pipeline-search">
      <Icon name="search" size={13} />
      <input
        type="search"
        id="pipeline-search"
        placeholder="Search project, operator, city…"
        aria-label="Search projects"
        autocomplete="off"
      />
      <kbd class="search-hint" aria-hidden="true">/</kbd>
    </span>
    <button class="tab saved-toggle" type="button" aria-pressed="false">
      <Icon name="bookmark" size={13} /> Saved only
    </button>
  </p>

  {/* Column filters live above the table, not inside <th> — the table head
      keeps plain labels and sort buttons only. */}
  <div class="pipeline-filterbar" id="pipeline-filterbar">
    {filters.map((f, fi) => (
      <div class="fb-item" data-col={f.key}>
        <button
          type="button"
          class="tab fb-btn"
          data-col={f.key}
          aria-expanded="false"
          aria-haspopup="true"
        >
          <Icon name="funnel" size={12} />
          {f.label}
        </button>
        <div
          class:list={['th-dropdown is-hidden', { 'th-dropdown--right': fi === filters.length - 1 }]}
          data-col={f.key}
          role="group"
          aria-label={`${f.label} filter`}
        >
          {f.lazy ? (
            <>
              <input
                type="search"
                class="th-dropdown-search"
                placeholder="Type to filter operators…"
                aria-label="Filter operator list"
              />
              <div class="th-options-host" />
            </>
          ) : (
            <>
              <label class="th-option th-option-all">
                <input type="checkbox" data-all checked />
                <span class="th-option-label">All</span>
              </label>
              {f.options.map((opt) => (
                <label class="th-option">
                  <input type="checkbox" value={opt.value} checked />
                  <span class="th-option-label">{opt.label}</span>
                  <span class="th-option-count">{opt.count}</span>
                </label>
              ))}
            </>
          )}
        </div>
      </div>
    ))}
  </div>

  <div class="pipeline-layout" id="pipeline-layout" data-mode="list">
    <div class="panel pipeline-panel">
      {serverRows.length > 0 ? (
        <table class="pipeline-table">
          <colgroup>
            <col style="width: 16%" />
            <col style="width: 11%" />
            <col style="width: 8.5%" />
            <col style="width: 10%" />
            <col style="width: 12%" />
            <col style="width: 9.5%" />
            <col style="width: 11%" />
            <col style="width: 12%" />
            <col style="width: 10%" />
          </colgroup>
          <thead>
            <tr>
              <th><span class="th-text">Project</span></th>
              <th><span class="th-text">Operator</span></th>
              <th><span class="th-text">Region</span></th>
              <th><span class="th-text">Country</span></th>
              <th><span class="th-text">Location</span></th>
              <th aria-sort="none">
                <button type="button" class="th-sort" data-sort="capacity" data-dir="none">
                  <span class="th-text">Capacity</span>
                  <span class="sort-arrow" aria-hidden="true"></span>
                </button>
              </th>
              <th class="col-invest" aria-sort="none">
                <button type="button" class="th-sort" data-sort="investment" data-dir="none">
                  <span class="th-text">Investment</span>
                  <span class="sort-arrow" aria-hidden="true"></span>
                </button>
              </th>
              <th><span class="th-text">Status</span></th>
              <th aria-sort="descending">
                <button type="button" class="th-sort" data-sort="updated" data-dir="desc">
                  <span class="th-text">Updated</span>
                  <span class="sort-arrow" aria-hidden="true"></span>
                </button>
              </th>
            </tr>
          </thead>
          <tbody id="pipeline-body">
            {serverRows.map(({ p, state, mx, my, geoExact }) => {
              const cap = formatCapacity(p);
              const meta = STATUS_META[p.status];
              const loc = [...new Set([p.city, state].filter(Boolean))].join(', ');
              return (
                <tr
                  data-id={p.id}
                  data-name={p.name}
                  data-mx={mx ?? ''}
                  data-my={my ?? ''}
                  data-exact={geoExact ? '1' : '0'}
                >
                  <td class="proj-name">
                    <FavButton type="projects" id={p.id} size={13} />
                    <a href={`${base}/projects/${p.id}/`}>{p.name}</a>
                  </td>
                  <td class="proj-operator" data-label="Operator" title={p.operator}>{p.operator}</td>
                  <td class="proj-region" data-label="Region"><span class="chip region">{regionChip(p.region)}</span></td>
                  <td class="proj-loc" data-label="Country" title={p.country}>{p.country}</td>
                  <td class="proj-loc" data-label="Location" title={loc}>{loc || <span class="is-empty">—</span>}</td>
                  <td class="proj-cap" data-label="Capacity">
                    <span class="cap-value" class:list={[{ 'is-empty': p.capacity_mw === null }]}>{cap.value}</span>
                    {cap.note && <span class="cap-note">{cap.note}</span>}
                  </td>
                  <td class="proj-invest" data-label="Investment">
                    {p.investment
                      ? <span title={p.investment}>{p.investment}</span>
                      : <span class="is-empty">—</span>}
                  </td>
                  <td data-label="Status"><span class={`badge ${meta.className}`}>{meta.label}</span></td>
                  <td class="proj-updated" data-label="Updated">
                    {p.last_updated ? shortDate(p.last_updated) : <span class="is-empty">—</span>}
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      ) : (
        <p class="pipeline-empty">No projects tracked yet.</p>
      )}
      <div class="pipeline-sentinel" id="pipeline-sentinel" hidden aria-hidden="true"></div>
      <div class="empty-state is-hidden" id="pipeline-empty">
        <span class="empty-icon empty-icon-saved"><Icon name="bookmark" size={26} /></span>
        <span class="empty-icon empty-icon-filter" hidden><Icon name="search" size={26} /></span>
        <p class="empty-title" id="pipeline-empty-title"></p>
        <p class="empty-sub" id="pipeline-empty-sub"></p>
      </div>
    </div>

    <aside class="map-rail">
      <section class="panel map-panel">
        <h2 class="panel-title">Capacity heat map</h2>
        <HeatMap heat={heatByCountry} pins={pins} />
      </section>
    </aside>
  </div>

  {/* Full dataset for the client-side renderer (slim precomputed rows). */}
  <script type="application/json" id="pipeline-data" set:html={clientJson} />

  <script>
    /* ---------- Data ---------- */
    interface RowData {
      id: string; name: string; op: string; rg: string; rc: string;
      co: string; st: string | null; ci: string; loc: string;
      stt: string; stl: string; stc: string;
      cap: number | null; capv: string; capn: string | null;
      lease: boolean;
      inv: string | null; invm: number | null;
      upd: string | null; upds: string | null;
      u: string; sea: string; mx: number | null; my: number | null; ex: boolean;
    }
    interface ClientData {
      rows: RowData[];
      operators: { value: string; label: string; count: number }[];
    }
    const DATA: ClientData = JSON.parse(
      document.getElementById('pipeline-data')!.textContent ?? '{"rows":[],"operators":[]}',
    );
    const SERVER_ROWS = 200;
    const PAGE = 300;

    const esc = (s: string) =>
      s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
       .replace(/"/g, '&quot;').replace(/'/g, '&#39;');

    /* ---------- List / map view toggle (persisted) ---------- */
    const layoutEl = document.getElementById('pipeline-layout');
    const modeBtns = [...document.querySelectorAll<HTMLButtonElement>('.view-toggle-btn')];

    function setMode(mode: string) {
      if (!layoutEl) return;
      layoutEl.dataset.mode = mode;
      modeBtns.forEach((b) => {
        const on = b.dataset.mode === mode;
        b.classList.toggle('is-active', on);
        b.setAttribute('aria-pressed', String(on));
      });
      try {
        localStorage.setItem('pipeline-mode', mode);
      } catch { /* private mode */ }
      syncUrl();
    }

    modeBtns.forEach((b) => b.addEventListener('click', () => setMode(b.dataset.mode ?? 'list')));

    const tbody = document.querySelector<HTMLTableSectionElement>('#pipeline-body');
    const sentinel = document.getElementById('pipeline-sentinel');
    const statCount = document.querySelector<HTMLElement>('#stat-count');
    const statMw = document.querySelector<HTMLElement>('#stat-mw');
    const emptyMsg = document.querySelector<HTMLElement>('#pipeline-empty');
    const searchInput = document.querySelector<HTMLInputElement>('#pipeline-search');
    const mapPins = [...document.querySelectorAll<SVGGElement>('#dc-map .pin')];

    let query = '';
    let savedOnly = false;
    const savedToggle = document.querySelector<HTMLButtonElement>('.saved-toggle');

    function favProjectIds(): Set<string> {
      try {
        const raw = JSON.parse(localStorage.getItem('dc-favs') ?? '{}');
        return new Set(Array.isArray(raw.projects) ? raw.projects : []);
      } catch {
        return new Set();
      }
    }

    /* ---------- Column filters ---------- */
    // Column key -> RowData field.
    const COL_FIELD: Record<string, (r: RowData) => string> = {
      operator: (r) => r.op,
      region: (r) => r.rg,
      country: (r) => r.co,
      status: (r) => r.stt,
    };

    const selected = new Map<string, Set<string>>();
    for (const col of Object.keys(COL_FIELD)) {
      const vals = col === 'operator'
        ? DATA.operators.map((o) => o.value)
        : [...new Set(DATA.rows.map((r) => COL_FIELD[col](r)))];
      selected.set(col, new Set(vals));
    }

    /* Lazy operator dropdown: options render (and re-render on typing) from
       the embedded JSON, checked state derived from `selected`. */
    const operatorHost = document.querySelector<HTMLElement>(
      '.th-dropdown[data-col="operator"] .th-options-host');
    const operatorSearch = document.querySelector<HTMLInputElement>(
      '.th-dropdown[data-col="operator"] .th-dropdown-search');

    function renderOperatorOptions() {
      if (!operatorHost) return;
      const allowed = selected.get('operator')!;
      const q = (operatorSearch?.value ?? '').trim().toLowerCase();
      const opts = DATA.operators.filter((o) => !q || o.label.toLowerCase().includes(q));
      const allBox = `<label class="th-option th-option-all"><input type="checkbox" data-all ${
        allowed.size === DATA.operators.length ? 'checked' : ''} /><span class="th-option-label">All</span></label>`;
      operatorHost.innerHTML = allBox + opts.map((o) =>
        `<label class="th-option"><input type="checkbox" value="${esc(o.value)}"${
          allowed.has(o.value) ? ' checked' : ''} /><span class="th-option-label">${esc(o.label)}</span>` +
        `<span class="th-option-count">${o.count}</span></label>`,
      ).join('');
    }

    operatorSearch?.addEventListener('input', renderOperatorOptions);

    /* Checkbox changes (delegated — operator options are rendered lazily). */
    document.querySelectorAll<HTMLElement>('.th-dropdown').forEach((dropdown) => {
      const col = dropdown.dataset.col ?? '';
      dropdown.addEventListener('change', (e) => {
        const box = (e.target as HTMLElement).closest('input[type="checkbox"]') as HTMLInputElement | null;
        if (!box) return;
        const allowed = selected.get(col)!;
        if (box.hasAttribute('data-all')) {
          const every = col === 'operator' ? DATA.operators.map((o) => o.value)
            : [...dropdown.querySelectorAll<HTMLInputElement>('input[type="checkbox"]:not([data-all])')].map((b) => b.value);
          if (box.checked) every.forEach((v) => allowed.add(v));
          else allowed.clear();
          if (col === 'operator') renderOperatorOptions();
          else dropdown.querySelectorAll<HTMLInputElement>('input[type="checkbox"]:not([data-all])')
            .forEach((b) => (b.checked = box.checked));
        } else {
          if (box.checked) allowed.add(box.value);
          else allowed.delete(box.value);
          const allBox = dropdown.querySelector<HTMLInputElement>('input[data-all]');
          if (allBox && col !== 'operator') {
            const boxes = [...dropdown.querySelectorAll<HTMLInputElement>('input[type="checkbox"]:not([data-all])')];
            const checked = boxes.filter((b) => b.checked).length;
            allBox.checked = checked === boxes.length;
            allBox.indeterminate = checked > 0 && checked < boxes.length;
          }
        }
        syncFilterButtons();
        applyFilters();
      });
    });

    function syncFilterButtons() {
      document.querySelectorAll<HTMLButtonElement>('.fb-btn').forEach((btn) => {
        const col = btn.dataset.col ?? '';
        const allowed = selected.get(col);
        if (!allowed) return;
        const total = col === 'operator'
          ? DATA.operators.length
          : new Set(DATA.rows.map((r) => COL_FIELD[col](r))).size;
        btn.classList.toggle('is-active', allowed.size < total);
      });
    }

    /* ---------- Filtering + stats + map sync ---------- */
    let current: RowData[] = DATA.rows;
    let shown = PAGE;

    function applyFilters() {
      const favs = savedOnly ? favProjectIds() : null;
      const entries = [...selected.entries()];
      current = DATA.rows.filter((r) =>
        entries.every(([col, allowed]) => allowed.has(COL_FIELD[col](r)))
        && (!query || r.sea.includes(query))
        && (!favs || favs.has(r.id)));

      let mw = 0;
      let x0 = Infinity, y0 = Infinity, x1 = -Infinity, y1 = -Infinity;
      const visibleIds = new Set<string>();
      for (const r of current) {
        visibleIds.add(r.id);
        mw += r.lease ? 0 : (r.cap ?? 0);
        if (r.mx !== null && r.my !== null) {
          x0 = Math.min(x0, r.mx); x1 = Math.max(x1, r.mx);
          y0 = Math.min(y0, r.my); y1 = Math.max(y1, r.my);
        }
      }
      mapPins.forEach((pin) =>
        pin.classList.toggle('is-hidden', !visibleIds.has(pin.dataset.id ?? '')));
      document.dispatchEvent(new CustomEvent('dcmap:visible', {
        detail: { ids: [...visibleIds] },
      }));
      if (statCount) statCount.textContent = `${current.length} ${current.length === 1 ? 'project' : 'projects'}`;
      if (statMw) statMw.textContent = `${Math.round(mw).toLocaleString('en-US')} MW tracked`;
      if (emptyMsg) {
        emptyMsg.classList.toggle('is-hidden', current.length > 0);
        if (current.length === 0) {
          const title = emptyMsg.querySelector('#pipeline-empty-title');
          const sub = emptyMsg.querySelector('#pipeline-empty-sub');
          const iconSaved = emptyMsg.querySelector('.empty-icon-saved');
          const iconFilter = emptyMsg.querySelector('.empty-icon-filter');
          if (savedOnly) {
            if (title) title.textContent = 'No saved projects yet';
            if (sub) sub.textContent = 'Tap the bookmark icon on any project to keep it here.';
          } else {
            if (title) title.textContent = 'No projects match';
            if (sub) sub.textContent = 'Try adjusting the search or column filters.';
          }
          iconSaved?.toggleAttribute('hidden', !savedOnly);
          iconFilter?.toggleAttribute('hidden', savedOnly);
        }
      }
      if (current.length > 0 && Number.isFinite(x0)) {
        document.dispatchEvent(new CustomEvent('dcmap:fit', { detail: { x0, y0, x1, y1 } }));
      }
      shown = PAGE;
      renderRows();
      syncUrl();
    }

    /* ---------- Client-side row rendering ---------- */
    const BOOKMARK = '<svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6.5 3.5h11a1 1 0 0 1 1 1v16l-6.5-4.2L5.5 20.5v-16a1 1 0 0 1 1-1z"/></svg>';

    function rowHtml(r: RowData): string {
      return `<tr data-id="${esc(r.id)}" data-name="${esc(r.name)}" data-mx="${r.mx ?? ''}" data-my="${r.my ?? ''}" data-exact="${r.ex ? '1' : '0'}">` +
        `<td class="proj-name"><button type="button" class="fav-btn" data-fav-type="projects" data-fav-id="${esc(r.id)}" aria-pressed="false" aria-label="Save this project" title="Save">${BOOKMARK}</button> <a href="${r.u}">${esc(r.name)}</a></td>` +
        `<td class="proj-operator" data-label="Operator" title="${esc(r.op)}">${esc(r.op)}</td>` +
        `<td class="proj-region" data-label="Region"><span class="chip region">${esc(r.rc)}</span></td>` +
        `<td class="proj-loc" data-label="Country" title="${esc(r.co)}">${esc(r.co)}</td>` +
        `<td class="proj-loc" data-label="Location" title="${esc(r.loc)}">${r.loc ? esc(r.loc) : '<span class="is-empty">—</span>'}</td>` +
        `<td class="proj-cap" data-label="Capacity"><span class="cap-value${r.cap === null ? ' is-empty' : ''}">${esc(r.capv)}</span>${r.capn ? `<span class="cap-note">${esc(r.capn)}</span>` : ''}</td>` +
        `<td class="proj-invest" data-label="Investment">${r.inv ? `<span title="${esc(r.inv)}">${esc(r.inv)}</span>` : '<span class="is-empty">—</span>'}</td>` +
        `<td data-label="Status"><span class="badge ${esc(r.stc)}">${esc(r.stl)}</span></td>` +
        `<td class="proj-updated" data-label="Updated">${r.upds ? esc(r.upds) : '<span class="is-empty">—</span>'}</td>` +
        `</tr>`;
    }

    function renderRows() {
      if (!tbody) return;
      tbody.innerHTML = current.slice(0, shown).map(rowHtml).join('');
      if (sentinel) sentinel.hidden = shown >= current.length;
      // New fav buttons need their saved state painted.
      document.dispatchEvent(new CustomEvent('dcfav:refresh'));
    }

    /* Infinite append: grow the window when the sentinel scrolls into view. */
    if (sentinel && 'IntersectionObserver' in window) {
      new IntersectionObserver((entries2) => {
        if (entries2.some((en) => en.isIntersecting) && shown < current.length) {
          shown += PAGE;
          renderRows();
        }
      }, { root: document.querySelector('.pipeline-panel'), rootMargin: '600px' }).observe(sentinel);
    }

    /* ---------- Search ---------- */
    let searchTimer = 0;
    searchInput?.addEventListener('input', () => {
      window.clearTimeout(searchTimer);
      searchTimer = window.setTimeout(() => {
        query = (searchInput.value ?? '').trim().toLowerCase();
        applyFilters();
      }, 140);
    });
    searchInput?.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape') return;
      searchInput.value = '';
      query = '';
      applyFilters();
      searchInput.blur();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key !== '/' || (e.target as HTMLElement).closest('input, textarea, select')) return;
      e.preventDefault();
      searchInput?.focus();
    });

    /* Saved-only toggle (projects bookmarked via FavButton). */
    savedToggle?.addEventListener('click', () => {
      savedOnly = !savedOnly;
      savedToggle.classList.toggle('is-active', savedOnly);
      savedToggle.setAttribute('aria-pressed', String(savedOnly));
      applyFilters();
    });
    document.addEventListener('dcfav:change', () => {
      if (savedOnly) applyFilters();
    });

    /* ---------- Dropdown open / close ---------- */
    const filterBtns = [...document.querySelectorAll<HTMLButtonElement>('.fb-btn')];

    function closeDropdowns() {
      document.querySelectorAll<HTMLElement>('.th-dropdown').forEach((dd) => dd.classList.add('is-hidden'));
      filterBtns.forEach((btn) => btn.setAttribute('aria-expanded', 'false'));
    }

    filterBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const dropdown = btn.closest('.fb-item')?.querySelector<HTMLElement>('.th-dropdown');
        if (!dropdown) return;
        const willOpen = dropdown.classList.contains('is-hidden');
        closeDropdowns();
        if (willOpen) {
          if (btn.dataset.col === 'operator' && operatorHost && !operatorHost.hasChildNodes()) {
            renderOperatorOptions();
          }
          dropdown.classList.remove('is-hidden');
          btn.setAttribute('aria-expanded', 'true');
        }
      });
    });

    document.addEventListener('click', (e) => {
      if (!(e.target as HTMLElement).closest('.fb-item')) closeDropdowns();
    });

    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape') return;
      const openBtn = filterBtns.find((btn) => btn.getAttribute('aria-expanded') === 'true');
      closeDropdowns();
      openBtn?.focus();
    });

    /* ---------- Sorting (data-level, then re-render) ---------- */
    const sortBtns = [...document.querySelectorAll<HTMLButtonElement>('.th-sort')];

    function applySort(key: string, dir: string) {
      const mul = dir === 'asc' ? 1 : -1;
      current = [...current].sort((a, b) => {
        if (key === 'capacity' || key === 'investment') {
          const av = key === 'capacity' ? a.cap : a.invm;
          const bv = key === 'capacity' ? b.cap : b.invm;
          if (av === null) return bv === null ? 0 : 1;
          if (bv === null) return -1;
          return (av - bv) * mul;
        }
        const av = a.upd ?? '';
        const bv = b.upd ?? '';
        if (av === '') return bv === '' ? 0 : 1;
        if (bv === '') return -1;
        return (av < bv ? -1 : av > bv ? 1 : 0) * mul;
      });
      renderRows();
      syncUrl();
    }

    sortBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const nextDir = btn.dataset.dir === 'desc' ? 'asc' : 'desc';
        sortBtns.forEach((b) => {
          b.dataset.dir = 'none';
          b.closest('th')?.setAttribute('aria-sort', 'none');
        });
        btn.dataset.dir = nextDir;
        btn.closest('th')?.setAttribute('aria-sort', nextDir === 'asc' ? 'ascending' : 'descending');
        applySort(btn.dataset.sort ?? 'updated', nextDir);
      });
    });

    /* ---------- Row hover -> map pin (event delegation) ---------- */
    let hoverTr: HTMLTableRowElement | null = null;
    tbody?.addEventListener('mouseover', (e) => {
      const tr = (e.target as HTMLElement).closest('tr');
      if (!tr || tr === hoverTr) return;
      hoverTr = tr as HTMLTableRowElement;
      const sx = parseFloat(hoverTr.dataset.mx ?? '');
      const sy = parseFloat(hoverTr.dataset.my ?? '');
      if (Number.isNaN(sx) || Number.isNaN(sy)) return;
      document.dispatchEvent(new CustomEvent('dcmap:locate', {
        detail: {
          x: sx,
          y: sy,
          label: hoverTr.dataset.name ?? '',
          approx: hoverTr.dataset.exact === '0',
        },
      }));
    });
    tbody?.addEventListener('mouseleave', () => {
      hoverTr = null;
      document.dispatchEvent(new CustomEvent('dcmap:unlocate'));
    });

    /* ---------- URL state ---------- */
    function syncUrl() {
      const p = new URLSearchParams();
      if (query) p.set('q', query);
      if (savedOnly) p.set('saved', '1');
      for (const [col, allowed] of selected) {
        const total = col === 'operator'
          ? DATA.operators.length
          : new Set(DATA.rows.map((r) => COL_FIELD[col](r))).size;
        if (allowed.size < total) {
          p.set(col, allowed.size === 0 ? '__none__' : [...allowed].join(','));
        }
      }
      const activeSort = sortBtns.find((b) => b.dataset.dir && b.dataset.dir !== 'none');
      if (activeSort && !(activeSort.dataset.sort === 'updated' && activeSort.dataset.dir === 'desc')) {
        p.set('sort', activeSort.dataset.sort ?? '');
        p.set('dir', activeSort.dataset.dir ?? '');
      }
      if (layoutEl?.dataset.mode === 'map') p.set('mode', 'map');
      const qs = p.toString();
      history.replaceState(null, '', location.pathname + (qs ? `?${qs}` : ''));
    }

    function restoreFromUrl() {
      const p = new URLSearchParams(location.search);
      const q0 = p.get('q');
      if (q0 && searchInput) {
        searchInput.value = q0;
        query = q0.trim().toLowerCase();
      }
      if (p.get('saved') === '1' && savedToggle) {
        savedOnly = true;
        savedToggle.classList.add('is-active');
        savedToggle.setAttribute('aria-pressed', 'true');
      }
      for (const col of Object.keys(COL_FIELD)) {
        const raw = p.get(col);
        if (raw === null) continue;
        const allowed = selected.get(col)!;
        if (raw === '__none__') {
          allowed.clear();
        } else {
          const wanted = new Set(raw.split(','));
          for (const v of [...allowed]) if (!wanted.has(v)) allowed.delete(v);
        }
        if (col !== 'operator') {
          const dropdown = document.querySelector<HTMLElement>(`.th-dropdown[data-col="${col}"]`);
          dropdown?.querySelectorAll<HTMLInputElement>('input[type="checkbox"]').forEach((b) => {
            if (b.hasAttribute('data-all')) return;
            b.checked = allowed.has(b.value);
          });
          const allBox = dropdown?.querySelector<HTMLInputElement>('input[data-all]');
          const boxes = dropdown ? [...dropdown.querySelectorAll<HTMLInputElement>('input[type="checkbox"]:not([data-all])')] : [];
          if (allBox) {
            const checked = boxes.filter((b) => b.checked).length;
            allBox.checked = checked === boxes.length;
            allBox.indeterminate = checked > 0 && checked < boxes.length;
          }
        }
      }
      const sortKey = p.get('sort');
      const sortDir = p.get('dir') === 'asc' ? 'asc' : 'desc';
      if (sortKey && ['capacity', 'investment', 'updated'].includes(sortKey)) {
        sortBtns.forEach((b) => {
          const on = b.dataset.sort === sortKey;
          b.dataset.dir = on ? sortDir : 'none';
          b.closest('th')?.setAttribute('aria-sort', on ? (sortDir === 'asc' ? 'ascending' : 'descending') : 'none');
        });
      }
      if (p.get('mode') === 'map') setMode('map');
      else {
        try {
          const savedMode = localStorage.getItem('pipeline-mode');
          if (!p.get('mode') && (savedMode === 'map' || savedMode === 'list')) setMode(savedMode);
        } catch { /* private mode */ }
      }
      syncFilterButtons();
    }

    restoreFromUrl();

    /* First paint: the server already rendered the first SERVER_ROWS rows in
       the default order; just top up to a full PAGE from the data. */
    if (DATA.rows.length > SERVER_ROWS && tbody) {
      tbody.insertAdjacentHTML(
        'beforeend',
        DATA.rows.slice(SERVER_ROWS, Math.min(PAGE, DATA.rows.length)).map(rowHtml).join(''),
      );
      if (sentinel) sentinel.hidden = DATA.rows.length <= PAGE;
      document.dispatchEvent(new CustomEvent('dcfav:refresh'));
    }
    // If the URL carried any state, re-render through the filter pipeline.
    if (location.search) applyFilters();
  </script>
</Base>
